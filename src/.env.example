# Copy to .env.local and fill in per environment.
# Vite (current prototype) reads VITE_*; Next.js reads NEXT_PUBLIC_*.
# Leave API_BASE_URL empty to run the prototype against local fixtures.

VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_AUTH_REDIRECT_PATH=/dashboard

# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_AUTH_REDIRECT_PATH=/dashboard
