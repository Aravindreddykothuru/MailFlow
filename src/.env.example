# Copy to .env.local and fill in per environment.
# Vite reads VITE_*; Next.js reads NEXT_PUBLIC_*.
#
# ── Prototype mode (default) ─────────────────────────────────────────────────
# Leave VITE_API_BASE_URL empty. All API calls resolve local fixtures.
# No backend or Docker needed. Run: npm run dev
#
# ── Real backend mode ─────────────────────────────────────────────────────────
# Set VITE_API_BASE_URL to point at the running Express backend.
# Start backend first: cd backend && docker compose up -d && npm run dev
#
VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://localhost:4000

# Google OAuth client id (shown on the login page button in prototype mode only).
VITE_GOOGLE_CLIENT_ID=
VITE_AUTH_REDIRECT_PATH=/dashboard

# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_AUTH_REDIRECT_PATH=/dashboard
