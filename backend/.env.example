# ──────────────────────────────────────────────────────────────────────────────
# ReachInbox Email Scheduler — Backend Environment Configuration
# Copy this file to .env and configure for real production use.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database & Redis ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mailflow:mailflow@localhost:5432/mailflow
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── JWT Session Secret ────────────────────────────────────────────────────────
# Secret used to sign session cookies (min 16 chars)
JWT_SECRET=production-grade-random-secret-key-for-reachinbox-mailflow-2024
JWT_EXPIRES_IN=7d

# ── REAL EMAIL SENDING (SMTP) ─────────────────────────────────────────────────
# Configure this section to send REAL emails to actual recipients' inboxes!
#
# Option A — Gmail (Easiest, free):
#   1. Go to your Google Account > Security > 2-Step Verification > App passwords
#   2. Create an App password named "MailFlow" (generates a 16-character code)
#   3. Fill in:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_SECURE=false
#      SMTP_USER=your_email@gmail.com
#      SMTP_PASS=your_16_char_app_password
#      SMTP_FROM_EMAIL=your_email@gmail.com
#      SMTP_FROM_NAME=Your Name
#
# Option B — Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net), Brevo, AWS SES
#
# (If left blank, automatically uses Ethereal test inbox with browser preview links)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MailFlow Dispatcher
SMTP_FROM_EMAIL=

# ── GOOGLE OAUTH 2.0 (Optional) ───────────────────────────────────────────────
# Only needed if you want "Continue with Google" button with real Google OAuth.
# (Email & Password sign-in/sign-up works without this)
#
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── WORKER TUNABLES ───────────────────────────────────────────────────────────
# Concurrency: how many emails are processed concurrently
WORKER_CONCURRENCY=3

# Minimum delay in milliseconds between consecutive dispatches (e.g. 15000 = 15s)
MIN_DELAY_MS=15000

# Hourly rate limit per sender (Redis-backed counter across workers)
MAX_EMAILS_PER_HOUR_PER_SENDER=50
